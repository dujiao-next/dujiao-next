{
  "name": "Dujiao-Next Development",

  "dockerComposeFile": "docker-compose.yml",

  "service": "app",

  "workspaceFolder": "/workspaces/dujiao-next",

  "shutdownAction": "stopCompose",

  "forwardPorts": [
    8080,
    5173,
    5174
  ],

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "Vue.volar",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  // postCreateCommand 只在「容器创建时」执行，是补装依赖的正确时机：
  // node_modules/ 不受 git 跟踪，宿主目录被移动后不会随 git restore 回来，
  // 必须在这里补装，否则前台/后台的 dev server 起不来。
  // 注意先 cd 进子目录再执行 pnpm —— corepack 按「当前目录 package.json 的
  // packageManager 字段」解析版本，在仓库根目录执行会拿到另一个 pnpm 大版本。
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.34.3 --activate && go mod download && (cd frontend/user && pnpm install) && (cd frontend/admin && pnpm install)",

  // 用 ${containerWorkspaceFolder} 拼出绝对路径，而不是写相对路径。
  //
  // 相对路径隐含依赖「postStartCommand 的工作目录恰好等于 workspaceFolder」。
  // 一旦容器复用了迁移/重命名前创建的旧容器，其 bind 源指向已失效的宿主路径，
  // 工作目录下空空如也，命令会以 exit 127（No such file or directory）失败。
  // 而 Dev Containers 把 postStartCommand 失败视为致命错误：
  //   postStartCommand from devcontainer.json failed with exit code 127.
  //   Skipping any further user-provided commands.
  // 随后整个附加流程失败、容器打不开 —— 用户看到的就是「无法打开该容器或项目」。
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-dev.sh"
}