{
  "name": "Dujiao-Next Development",

  "dockerComposeFile": "docker-compose.yml",

  "service": "app",

  "workspaceFolder": "/workspaces/dujiao-next",

  "shutdownAction": "stopCompose",

  "forwardPorts": [
    8080,
    5173,
    5174
  ],

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "Vue.volar",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  // 这里只做「不依赖工作区状态」的事。
  //
  // 反面教材：曾在此追加 (cd frontend/user && pnpm install)。当 node_modules 已存在
  // 但属主不是 vscode 时（例如有人以 root 在容器里装过一次），它会以
  //   EACCES: permission denied, open '.../node_modules/.pnpm/.../.bin/tsc'
  // 失败；而生命周期命令一旦以非零码结束，Dev Containers 会打印
  //   postCreateCommand ... failed with exit code 243.
  //   Skipping any further user-provided commands.
  // 并跳过包括 postStartCommand 在内的**所有后续命令** —— 容器看起来是打开的，
  // 三个服务却一个都没起，日志里只有一行 EACCES，极难定位。
  //
  // 前端依赖因此改为按需手动安装（见 README 8.5）：
  //   cd frontend/user && pnpm install
  //   cd ../admin      && pnpm install
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.34.3 --activate && go mod download",

  // 用 ${containerWorkspaceFolder} 拼出绝对路径，而不是写相对路径。
  //
  // 相对路径隐含依赖「postStartCommand 的工作目录恰好等于 workspaceFolder」。
  // 一旦容器复用了迁移/重命名前创建的旧容器，其 bind 源指向已失效的宿主路径，
  // 工作目录下空空如也，命令会以 exit 127（No such file or directory）失败。
  // 而 Dev Containers 把 postStartCommand 失败视为致命错误：
  //   postStartCommand from devcontainer.json failed with exit code 127.
  //   Skipping any further user-provided commands.
  // 随后整个附加流程失败、容器打不开 —— 用户看到的就是「无法打开该容器或项目」。
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-dev.sh"
}